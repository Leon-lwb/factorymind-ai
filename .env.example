# ============================================================
# FactoryMind AI — environment template
# Copy to .env and fill in. NEVER commit a real .env file.
# ============================================================

# ---------- AI Provider (spec §20) ----------
# mock | openai-compatible | local
# Default is `mock` so the full demo loop runs with no API key and no network.
#   openai-compatible = hosted API speaking the OpenAI chat-completions spec
#                       (requires AI_BASE_URL + AI_MODEL + AI_API_KEY)
#   local             = self-hosted server (Ollama / vLLM / LM Studio),
#                       requires AI_BASE_URL + AI_MODEL, no key
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# ---------- Industrial Data Provider (spec §22 / §42) ----------
# mock | supos
# `mock`  = MockIndustrialDataProvider (reproducible synthetic data)
# `supos` = SupOSProvider (real open supOS instance)
DATA_PROVIDER=mock

# open supOS connection (only required when DATA_PROVIDER=supos)
# Gateway port defaults to 8088 in supOS CE deploy.
SUPOS_API_URL=
# Bearer token presented to the gateway. Obtain it via the Keycloak
# authorization-code flow (see docs/SUPOS_INTEGRATION.md). Never commit a real token.
SUPOS_API_TOKEN=
SUPOS_TIMEOUT_SECONDS=10
SUPOS_VERIFY_TLS=true
# Optional: restrict UNS traversal to a subtree alias (e.g. the plant root).
SUPOS_UNS_ROOT_ALIAS=
# Event source for SupOSProvider: mqtt (only supported value)
#   supOS CE exposes no REST event-query endpoint, so events are always
#   ingested from the EMQX stream and SUPOS_MQTT_URL is required.
SUPOS_EVENT_SOURCE=mqtt
# MQTT broker (EMQX) for the realtime event path, e.g. mqtt://<host>:1883
SUPOS_MQTT_URL=
SUPOS_MQTT_TOPIC=factorymind/uns/#
SUPOS_USERNAME=
SUPOS_PASSWORD=

# ---------- AI Engine service ----------
AI_ENGINE_HOST=127.0.0.1
AI_ENGINE_PORT=8100